<Window x:Class="StudentFilesApp.ExportSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Параметры выгрузки" Height="470" Width="400"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgGray}">
    <Border Margin="20" Background="White" CornerRadius="8" Padding="20">
        <StackPanel>
            <TextBlock Text="Выберите данные для выгрузки" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="{StaticResource DarkBlue}"/>

            
            <TextBlock Text="Выберите группу:" Margin="0,0,0,5" Foreground="{StaticResource MidBlue}"/>
            <ComboBox x:Name="CmbExportGroup" Height="30" Margin="0,0,0,15"/>

            <TextBlock Text="Выберите столбцы:" Margin="0,0,0,5" Foreground="{StaticResource MidBlue}"/>
            <CheckBox x:Name="ChkFullName" Content="ФИО" IsChecked="False" Margin="0,5"/>
            <CheckBox x:Name="ChkGroup" Content="Группа" IsChecked="False" Margin="0,5"/>
            <CheckBox x:Name="ChkGender" Content="Пол" IsChecked="False" Margin="0,5"/>
            <CheckBox x:Name="ChkStatus" Content="Статус" IsChecked="False" Margin="0,5"/>
            <CheckBox x:Name="ChkBirthDate" Content="Дата рождения" IsChecked="False" Margin="0,5"/>
            <CheckBox x:Name="ChkPhone" Content="Телефон" IsChecked="False" Margin="0,5"/>

            <Button Content="Выгрузить" Height="40" Margin="0,20,0,0" 
                    Background="{StaticResource DarkBlue}" Foreground="White" Click="BtnExport_Click"/>
        </StackPanel>
    </Border>
</Window>