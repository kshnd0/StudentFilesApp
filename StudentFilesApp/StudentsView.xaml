<UserControl x:Class="StudentFilesApp.StudentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ПАНЕЛЬ: Дерево групп из БД -->
        <Border Grid.Column="0" Background="White" CornerRadius="8" Margin="0,0,20,0" Padding="15" 
                BorderBrush="{StaticResource BgGray}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Группы" FontWeight="Bold" FontSize="18" Foreground="{StaticResource DarkBlue}" Margin="0,0,0,15"/>

                    <!-- Дерево, которое мы заполним кодом -->
                    <TreeView x:Name="GroupsTreeView" BorderThickness="0" Background="Transparent" SelectedItemChanged="TreeView_SelectedItemChanged"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ПРАВАЯ ПАНЕЛЬ: Таблица студентов -->
        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20"
                BorderBrush="{StaticResource BgGray}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Поиск -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Height="35" Text="Поиск по ФИО..." Foreground="{StaticResource LightBlue}"/>
                    <Button Grid.Column="1" Content="+ Добавить студента" Background="{StaticResource DarkBlue}" Margin="15,0,0,0"/>
                </Grid>

                <!-- Таблица студентов -->
                <DataGrid x:Name="StudentsDataGrid" Grid.Row="1" AutoGenerateColumns="False" RowHeaderWidth="0"
                          IsReadOnly="True" BorderBrush="{StaticResource BgGray}" 
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                        <DataGridTextColumn Header="Группа" Binding="{Binding Group.GroupName}" Width="150"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>