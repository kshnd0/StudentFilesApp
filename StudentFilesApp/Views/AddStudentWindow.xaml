<Window x:Class="StudentFilesApp.AddStudentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление студента" Height="670" Width="400"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgGray}">
    <Border Margin="20" Background="White" CornerRadius="8" Padding="20">
        <StackPanel>
            <TextBlock Text="Новый студент" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" Foreground="{StaticResource DarkBlue}"/>

            <TextBlock Text="Фамилия *" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtLastName" Height="30" Margin="0,0,0,10"/>

            <TextBlock Text="Имя *" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtFirstName" Height="30" Margin="0,0,0,10"/>

            <TextBlock Text="Отчество" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtMiddleName" Height="30" Margin="0,0,0,10"/>

            <TextBlock Text="Дата рождения" Margin="0,0,0,5"/>
            <DatePicker x:Name="DpBirthDate" Height="30" Margin="0,0,0,10"/>

            <TextBlock Text="Телефон" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtPhone" Height="30" Margin="0,0,0,10"/>

            <TextBlock Text="Группа *" Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbGroup" Height="30" Margin="0,0,0,20"/>
            <TextBlock Text="Или введите новую (например, ИПсп-127):" Margin="0,0,0,5" Foreground="#778DA9" FontSize="11"/>
            <TextBox x:Name="TxtNewGroup" Height="30" Margin="0,0,0,20"/>

            <Button Content="Сохранить" Height="40" Background="{StaticResource DarkBlue}" Foreground="White" Click="BtnSave_Click"/>

            <Button Content="Сохранить" Height="40" Background="{StaticResource DarkBlue}" Foreground="White" Click="BtnSave_Click"/>
        </StackPanel>
    </Border>
</Window>