<Window x:Class="StudentFilesApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Личные дела студентов" Height="800" Width="1280"
        WindowStartupLocation="CenterScreen" Background="#E0E1DD">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        
        <Border Grid.Column="0" Background="{StaticResource DarkestBlue}">
            <StackPanel>
                
                <Border BorderBrush="{StaticResource DarkBlue}" BorderThickness="0,0,0,1" Padding="20">
                    <StackPanel>
                        <TextBlock x:Name="TxtUserName" Text="Иванов И.И." Foreground="White" FontWeight="Bold" FontSize="16"/>
                        <TextBlock x:Name="TxtUserRole" Text="Сотрудник деканата" Foreground="{StaticResource LightBlue}" FontSize="12"/>
                    </StackPanel>
                </Border>


                <Button x:Name="BtnHome" Content="🏠 Главная" Background="Transparent" Foreground="White" 
        HorizontalContentAlignment="Left" Padding="20,15" BorderThickness="0"
        Click="BtnHome_Click"/>

                <Button x:Name="BtnStudents" Content="👥 Студенты" Background="Transparent" Foreground="White" 
        HorizontalContentAlignment="Left" Padding="20,15" BorderThickness="0"
        Click="BtnStudents_Click"/>

                <Button Content="⚙ Пользователи" Background="Transparent" Foreground="{StaticResource LightBlue}" 
        HorizontalContentAlignment="Left" Padding="20,15" BorderThickness="0"/>
                
            </StackPanel>
        </Border>

       
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BgGray}" BorderThickness="0,0,0,2" Padding="20,0">
                <Grid>
                    <TextBlock Text="Добро пожаловать!" FontSize="20" VerticalAlignment="Center" 
                               Foreground="{StaticResource DarkestBlue}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtCurrentDate" Text="Дата: 18.10.2026" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource LightBlue}"/>
                </Grid>
            </Border>

           
            <ContentControl Grid.Row="1" x:Name="MainContent" Margin="20"/>
        </Grid>
    </Grid>
</Window>