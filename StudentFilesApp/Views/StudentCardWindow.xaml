<Window x:Class="StudentFilesApp.StudentCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Личное дело студента" Height="850" Width="1000"
        WindowStartupLocation="CenterScreen" Background="#E0E1DD">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="120" Height="150" Background="#E0E1DD" CornerRadius="4" BorderBrush="#778DA9" BorderThickness="1">
                    <TextBlock Text="Фото 3x4" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#778DA9"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">

                    <TextBox x:Name="TxtFullName" Text="Иванов Иван Иванович" FontSize="26" FontWeight="Bold"
                             Foreground="#0D1B2A" BorderThickness="0" Background="Transparent" IsReadOnly="False"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Border Background="#C8E6C9" CornerRadius="4" Padding="8,4" Margin="0,0,10,0">
                            <TextBlock x:Name="TxtStatus" Text="Обучается" Foreground="#2E7D32" FontWeight="Bold"/>
                        </Border>
                        <TextBlock x:Name="TxtGroupInfo" Text="Группа: ИПсп-123 | Курс: 4 | Форма: Очная" FontSize="14" VerticalAlignment="Center" Foreground="#415A77"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="2" Content="📄 Сформировать справку" Click="BtnCreateReport_Click" Background="#1B263B" Foreground="White" 
                        Padding="15,10" VerticalAlignment="Top" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>


        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Text="Персональные данные" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Foreground="#415A77"/>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Дата рождения:" Foreground="#778DA9" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <DatePicker x:Name="DpBirthDate" Width="130" IsEnabled="False" />
                            <TextBlock x:Name="TxtAge" Text="" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#2E7D32"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Пол:" Foreground="#778DA9" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbGender" Grid.Column="1" VerticalAlignment="Center" Width="120" Margin="0,0,200,0">
                            <ComboBoxItem Content="Мужской"/>
                            <ComboBoxItem Content="Женский"/>
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Гражданство:" Foreground="#778DA9" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtCitizenship" Grid.Column="1" Text="Российская Федерация" VerticalAlignment="Center" Foreground="#0D1B2A"/>
                    </Grid>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Дата зачисления:" Foreground="#778DA9" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtEnrollmentDate" Grid.Column="1" Text="01.09.2023" VerticalAlignment="Center" Foreground="#0D1B2A"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Документы и контакты" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Foreground="#415A77"/>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Телефон:" Foreground="#778DA9" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtPhone" Grid.Column="1" Text="+7 (999) 123-45-67" VerticalAlignment="Center" Foreground="#0D1B2A"/>
                    </Grid>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Email:" Foreground="#778DA9" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtEmail" Grid.Column="1" Text="ivanov@example.com" VerticalAlignment="Center" Foreground="#0D1B2A"/>
                    </Grid>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Адрес:" Foreground="#778DA9" VerticalAlignment="Top"/>
                        <TextBlock x:Name="TxtAddress" Grid.Column="1" Text="г. Владимир, ул. Ленина, д. 10, кв. 5" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#0D1B2A"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>


        <TabControl Grid.Row="2" Background="White" BorderThickness="0" Padding="10">
            <TabItem Header="Приказы">
                <Grid>
                    <DataGrid x:Name="OrdersDataGrid" AutoGenerateColumns="False" HeadersVisibility="Column" RowHeaderWidth="0" Margin="0,10,0,0" BorderBrush="#E0E1DD">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Номер" Binding="{Binding OrderNumber}" Width="100"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding OrderDate}" Width="100"/>
                            <DataGridTextColumn Header="Примечание" Binding="{Binding Comment}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Родители">
                <Grid Margin="10">
                    <StackPanel>
                        <TextBlock Text="Данные о родителе" FontWeight="Bold" Margin="0,0,0,10" Foreground="#415A77"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="ФИО:" Foreground="#778DA9"/>
                            <TextBlock x:Name="TxtParentName" Grid.Column="1" Text="" Foreground="#0D1B2A"/>

                            <TextBlock Grid.Row="1" Text="Степень родства:" Foreground="#778DA9"/>
                            <TextBlock x:Name="TxtParentRelation" Grid.Row="1" Grid.Column="1" Text="" Foreground="#0D1B2A"/>

                            <TextBlock Grid.Row="2" Text="Телефон:" Foreground="#778DA9"/>
                            <TextBlock x:Name="TxtParentPhone" Grid.Row="2" Grid.Column="1" Text="" Foreground="#0D1B2A"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Успеваемость">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="GradesDataGrid" AutoGenerateColumns="False" RowHeaderWidth="0" BorderBrush="#E0E1DD">

                        
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDebt}" Value="True">
                                        <Setter Property="Background" Value="#FFCDD2"/>
                                        
                                        <Setter Property="Foreground" Value="#C62828"/>
                                       
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDebt}" Value="False">
                                        <Setter Property="Background" Value="#C8E6C9"/>
                                      
                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                        
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                       

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дисциплина" Binding="{Binding DisciplineName}" Width="*"/>
                            <DataGridTextColumn Header="Часы" Binding="{Binding TotalHours}" Width="100"/>
                            <DataGridTextColumn Header="Оценка" Binding="{Binding GradeValue}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="1" Content="Сформировать направление на сдачу долга" 
                Click="BtnCreateDebtReport_Click"
                HorizontalAlignment="Right" Margin="0,15,0,0" 
                Background="#C62828" Foreground="White" Padding="15,8" BorderThickness="0"/>
                </Grid>
            </TabItem>

            <TabItem Header="Портфолио">
                <TextBlock Text="Список грамот и достижений..." Margin="10" Foreground="#778DA9"/>
            </TabItem>

            <TabItem Header="Документы">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ComboBox Width="200" Height="30" Margin="0,0,10,0">
                            <ComboBoxItem Content="Выберите тип документа" IsSelected="True"/>
                            <ComboBoxItem Content="Паспорт"/>
                            <ComboBoxItem Content="СНИЛС"/>
                            <ComboBoxItem Content="Аттестат"/>
                        </ComboBox>
                        <Button Content="📎 Загрузить скан" Background="#415A77" Foreground="White" Padding="10,5" BorderThickness="0"/>
                    </StackPanel>

                    <ListBox Grid.Row="1" BorderThickness="1" BorderBrush="#E0E1DD">
                        <ListBoxItem Content="📄 Паспорт.pdf (Загружен 12.10.2026)" Foreground="#0D1B2A"/>
                        <ListBoxItem Content="📄 Аттестат.jpg (Загружен 12.10.2026)" Foreground="#0D1B2A"/>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>


        <Button x:Name="BtnSaveChanges" Grid.Row="3" Content="💾 Сохранить изменения" 
        Click="BtnSaveChanges_Click"
        HorizontalAlignment="Right" Margin="0,15,0,0" 
        Padding="15,10" Background="{StaticResource DarkBlue}" Foreground="White" 
        BorderThickness="0" Cursor="Hand"/>
    </Grid>
</Window>