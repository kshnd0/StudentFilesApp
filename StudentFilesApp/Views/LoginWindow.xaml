<Window x:Class="StudentFilesApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в систему" Height="500" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" 
        Background="{StaticResource BgGray}">

   
    <Border Margin="20" Background="White" CornerRadius="10" Padding="30" >
       
        <StackPanel VerticalAlignment="Center">

            
            <TextBlock Text="ЛИЧНЫЕ ДЕЛА" FontSize="26" FontWeight="Bold" 
                       HorizontalAlignment="Center" Foreground="{StaticResource DarkestBlue}"/>
            <TextBlock Text="Автоматизированая система учета" FontSize="12" HorizontalAlignment="Center" 
                       Foreground="{StaticResource LightBlue}" Margin="0,5,0,30"/>

            
            <TextBlock Text="Логин" Foreground="{StaticResource MidBlue}" Margin="0,0,0,5"/>
            
            <TextBox x:Name="TxtLogin" Height="35" Margin="0,0,0,15" VerticalContentAlignment="Center" Padding="5"/>

            <TextBlock Text="Пароль" Foreground="{StaticResource MidBlue}" Margin="0,0,0,5"/>
            
            <PasswordBox x:Name="TxtPassword" Height="35" Margin="0,0,0,30" BorderBrush="{StaticResource LightBlue}" Padding="5" VerticalContentAlignment="Center"/>

            
            <Button Content="Войти в систему" Height="45" FontSize="16" 
                    Background="{StaticResource DarkBlue}" Click="BtnLogin_Click"/>

            <TextBlock Text="© 2026 Курсовая" HorizontalAlignment="Center" Margin="0,20,0,0" 
                       FontSize="11" Foreground="{StaticResource LightBlue}"/>
        </StackPanel>
    </Border>
</Window>