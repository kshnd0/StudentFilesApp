<UserControl x:Class="StudentFilesApp.StudentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

       
        <Border Grid.Column="0" Background="White" CornerRadius="8" Margin="0,0,20,0" Padding="15" 
                BorderBrush="{StaticResource BgGray}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Группы" FontWeight="Bold" FontSize="18" Foreground="{StaticResource DarkBlue}" Margin="0,0,0,15"/>

                <Button Grid.Row="1" Content="📥 Выгрузить в Excel" Click="BtnExportExcel_Click" 
                        Background="{StaticResource DarkBlue}" Foreground="White" Margin="0,0,0,15" Padding="10"/>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <TreeView x:Name="GroupsTreeView" BorderThickness="0" Background="Transparent" SelectedItemChanged="TreeView_SelectedItemChanged"/>
                </ScrollViewer>
            </Grid>
        </Border>

      
        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20"
                BorderBrush="{StaticResource BgGray}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                
                <Grid Margin="0,0,0,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                   
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtSearch" Height="35" VerticalContentAlignment="Center" Padding="5" 
                                 TextChanged="TxtSearch_TextChanged" ToolTip="Поиск по ФИО..."/>

                        <Button x:Name="BtnAddStudent" Grid.Column="1" Content="+ Добавить студента" 
                                Click="BtnAddStudent_Click"
                                Background="{StaticResource DarkBlue}" Foreground="White" Margin="15,0,0,0"/>
                    </Grid>

                   
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <ComboBox x:Name="CmbCourse" Width="100" Height="30" SelectionChanged="Filter_Changed" ToolTip="Курс">
                            <ComboBoxItem Content="Все курсы" IsSelected="True"/>
                            <ComboBoxItem Content="1 курс"/>
                            <ComboBoxItem Content="2 курс"/>
                            <ComboBoxItem Content="3 курс"/>
                            <ComboBoxItem Content="4 курс"/>
                        </ComboBox>

                        <ComboBox x:Name="CmbForm" Width="120" Height="30" Margin="10,0,0,0" SelectionChanged="Filter_Changed" ToolTip="Форма обучения">
                            <ComboBoxItem Content="Все формы" IsSelected="True"/>
                            <ComboBoxItem Content="Очная"/>
                            <ComboBoxItem Content="Заочная"/>
                        </ComboBox>

                        <ComboBox x:Name="CmbStatus" Width="120" Height="30" Margin="10,0,0,0" SelectionChanged="Filter_Changed" ToolTip="Статус">
                            <ComboBoxItem Content="Все статусы" IsSelected="True"/>
                            <ComboBoxItem Content="Обучается"/>
                            <ComboBoxItem Content="Академ"/>
                            <ComboBoxItem Content="Отчислен"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

               
                <DataGrid x:Name="StudentsDataGrid" Grid.Row="1" AutoGenerateColumns="False" RowHeaderWidth="0"
                          IsReadOnly="True" BorderBrush="{StaticResource BgGray}" 
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          MouseDoubleClick="DataGrid_MouseDoubleClick">

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="обучается">
                                    <Setter Property="Background" Value="#C8E6C9"/>
                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="академ">
                                    <Setter Property="Background" Value="#FFF9C4"/>
                                    <Setter Property="Foreground" Value="#E65100"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="отчислен">
                                    <Setter Property="Background" Value="#FFCDD2"/>
                                    <Setter Property="Foreground" Value="#C62828"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                        <DataGridTextColumn Header="Группа" Binding="{Binding Group.GroupName}" Width="150"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>